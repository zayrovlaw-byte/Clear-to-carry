# Copy to .env (local) or paste into your host's Variables screen (Railway).

# Public address of this site, used in emailed links
SITE_URL=https://cleartocarrynyc.com

# Firm dashboard at /admin (staff only, never clients). One entry per person,
# Name:password, separated by semicolons. Passwords 10+ characters.
ADMIN_USERS=Manny:change-this-long-password
# Alternative for a single login (signs in as "Attorney"):
ADMIN_PASSWORD=

# Automatic client reminders run hourly, 9am-7pm New York time. Set to off to disable.
REMINDERS=on

# Firm email (Google Workspace / Gmail). SMTP_PASS is a Google APP PASSWORD,
# not your normal password: Google Account -> Security -> 2-Step Verification -> App passwords.
SMTP_USER=you@yourfirmdomain.com
SMTP_PASS=
MAIL_FROM="Clear to Carry <you@yourfirmdomain.com>"
# Where new-lead / upload alerts go (defaults to SMTP_USER)
NOTIFY_EMAIL=you@yourfirmdomain.com

# Zelle receiving address shown at checkout and in the client email
NEXT_PUBLIC_ZELLE_TO=your-zelle-address

# Storage. On Railway, mount a Volume at /data and keep these as-is.
DATA_DIR=/data
UPLOAD_DIR=/data/uploads

# Optional scheduling link (Calendly, Acuity...). After booking, clients are
# offered it to pick a time. Leave empty and the firm calls to schedule.
NEXT_PUBLIC_BOOKING_URL=

# Card payments (Stripe). Leave empty and only Zelle is offered.
# Stripe dashboard -> Developers -> API keys -> Secret key (sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=
# Stripe dashboard -> Developers -> Webhooks -> endpoint https://cleartocarrynyc.com/api/stripe/webhook
# events checkout.session.completed and checkout.session.async_payment_succeeded -> Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
